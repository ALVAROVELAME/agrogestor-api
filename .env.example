# Configure um MariaDB acessível a partir do container (o Compose não cria o banco).
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=agrogestor
DB_USER=agrogestor
DB_PASSWORD=substitua_por_uma_senha_local

# Gere uma chave aleatória com pelo menos 32 bytes. Não use este marcador.
JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_ISSUER=agrogestor-api

MAIL_HOST=smtp.exemplo.com
MAIL_PORT=587
MAIL_USERNAME=seu_email@exemplo.com
MAIL_PASSWORD=substitua_pela_credencial_smtp
MAIL_FROM=AgroGestor <seu_email@exemplo.com>
APP_FRONTEND_URL=http://localhost:5173
PORT=8080
